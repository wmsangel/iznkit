# Secret used to sign one-time "unlock" tokens (HMAC). Set a long random value in production.
UNLOCK_SECRET=change-me-to-a-long-random-string

# Public site origin (used for canonical URLs, OG images, sitemap, payment return URLs).
NEXT_PUBLIC_SITE_URL=https://iznkit.com

# --- Payment providers (StubProvider is used until real keys exist) ---

# Lava.top (RU + international) — primary. Get these from the Lava dashboard (API / Integrations).
# LAVA_API_KEY=
# LAVA_WEBHOOK_SECRET=
# Webhook to configure in Lava:  {NEXT_PUBLIC_SITE_URL}/api/payments/webhook
# Success/return URL to configure: {NEXT_PUBLIC_SITE_URL}/{locale}/tools/<slug>?paid=1

# Lemon Squeezy (global, later) — Merchant of Record.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Credit store for packs (needed once packs go live; falls back to in-memory in dev) ---
# Upstash Redis (free tier):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
