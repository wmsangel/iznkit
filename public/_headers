# Cloudflare Workers Assets headers (static files only — SSR/API routes get their
# headers from next.config.ts `headers()`, which OpenNext honours on the Worker).
# This file adds long-lived caching to immutable static assets (hashed Next bundles,
# fonts, images) and mirrors the security headers onto static responses too.

# Hashed, content-addressed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and SVGs in public/ are stable — cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Security / trust headers on every static asset (HTML pages already get these
# from next.config). Kept in sync with next.config.ts securityHeaders.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-DNS-Prefetch-Control: on
