{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "iznkit",
  // No *.workers.dev mirror and no preview URLs — production is served only via
  // the iznkit.com custom domain, so there is no stray-analytics/duplicate host.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "iznkit"
    }
  ]
}
