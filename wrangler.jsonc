{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "iznkit",
  // No *.workers.dev mirror and no preview URLs — production is served only via
  // the iznkit.com custom domain, so there is no stray-analytics/duplicate host.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Production custom domains — CF manages the proxied DNS record for each and
  // routes it to this Worker (replaces the old Vercel apex/www records on cutover).
  "routes": [
    { "pattern": "iznkit.com", "custom_domain": true },
    { "pattern": "www.iznkit.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Rate-limiter + daily-cap counter for the Indoleads AI Ads pilot (server-side
  // proxy at /api/sponsored). Holds only per-day/per-minute request counts — no
  // ad content, no PII. The API key is a Worker secret (INDOLEADS_AI_ADS_KEY),
  // set via `wrangler secret put`, never in this file or the repo.
  "kv_namespaces": [
    { "binding": "INDOLEADS_ADS", "id": "98c0bad5433f496884b777949b214508" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "iznkit"
    }
  ]
}
